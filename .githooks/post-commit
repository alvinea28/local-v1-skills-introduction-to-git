#!/bin/sh
# Exercise Monitor - local git hook
# Notifies the exercise workflows that a commit was made.

ROOT=$(git rev-parse --show-toplevel)
SCRIPT="$ROOT/.exercise-monitor/send-event.ps1"

if command -v pwsh >/dev/null 2>&1; then
  PS=pwsh
else
  PS=powershell.exe
fi

"$PS" -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT" -Event post-commit
