{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Activity",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./start-activity.ps1",
      "windows": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-activity.ps1"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Stop Activity",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./stop-activity.ps1",
      "windows": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\stop-activity.ps1"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
